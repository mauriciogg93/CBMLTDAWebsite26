---
// WhatsApp CTA button (inline variant). For the floating one see WhatsAppFlotante.astro.
import { Icon } from 'astro-icon/components';
import { whatsappUrl } from '../site.config';

interface Props {
  mensaje?: string;
  etiqueta?: string;
  /** 'solido' on light backgrounds, 'contraste' on dark backgrounds. */
  variante?: 'solido' | 'contraste';
}

const { mensaje, etiqueta = 'Cotizar por WhatsApp', variante = 'solido' } = Astro.props;
---

<a
  href={whatsappUrl(mensaje)}
  target="_blank"
  rel="noopener"
  class:list={[
    'inline-flex items-center gap-2 rounded-lg px-5 py-3 font-semibold shadow-sm transition-colors',
    variante === 'solido'
      ? 'bg-whatsapp-oscuro text-white hover:bg-acento-700'
      : 'bg-white text-marca-700 hover:bg-marca-50',
  ]}
>
  <Icon name="simple-icons:whatsapp" class="h-5 w-5" aria-hidden="true" />
  {etiqueta}
  <span class="sr-only"> (abre en una pestaña nueva)</span>
</a>
