---
import { Image } from 'astro:assets';
import { SITE, whatsappUrl } from '../site.config';
import logoBlanco from '../assets/brand/logo-cbm-blanco.png';

const anio = new Date().getFullYear();
---

<footer class="bg-marca-900 text-gray-200">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:grid-cols-3">
    <div>
      <Image src={logoBlanco} alt={`Logo de ${SITE.nombre}`} class="h-12 w-auto" widths={[200, 400]} sizes="200px" />
      <p class="mt-4 text-sm leading-relaxed text-gray-300">
        Importación, distribución y servicio técnico de equipos bancarios y para embalaje
        desde {SITE.fundacion}.
      </p>
    </div>

    <div>
      <h2 class="text-sm font-semibold tracking-wide text-white uppercase">Encuéntranos</h2>
      <address class="mt-4 space-y-2 text-sm not-italic">
        <p>
          <a href={SITE.mapsUrl} rel="noopener" target="_blank" class="hover:text-white hover:underline">
            {SITE.direccion}, {SITE.ciudad} – {SITE.pais}
            <span class="sr-only"> (abre en una pestaña nueva)</span>
          </a>
        </p>
        <p>
          Tel: <a href={`tel:${SITE.telefonoE164}`} class="hover:text-white hover:underline">{SITE.telefono}</a>
        </p>
        <p>
          Celular / WhatsApp:{' '}
          <a href={whatsappUrl()} rel="noopener" target="_blank" class="hover:text-white hover:underline">
            {SITE.celular}
            <span class="sr-only"> (abre en una pestaña nueva)</span>
          </a>
        </p>
        <p>
          <a href={`mailto:${SITE.email}`} class="hover:text-white hover:underline">{SITE.email}</a>
        </p>
      </address>
    </div>

    <div>
      <h2 class="text-sm font-semibold tracking-wide text-white uppercase">Navegación</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {
          [...SITE.nav, ...SITE.navFooter].map((item) => (
            <li>
              <a href={item.href} class="hover:text-white hover:underline">
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/politica-de-datos/" class="hover:text-white hover:underline">
            Política de tratamiento de datos
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-marca-800">
    <p class="mx-auto max-w-6xl px-4 py-4 text-xs text-gray-400">
      © {anio} {SITE.nombreLegal} – {SITE.ciudad}, {SITE.pais}.
    </p>
  </div>
</footer>
