---
import { Icon } from 'astro-icon/components';
import { whatsappUrl } from '../site.config';
---

<a
  href={whatsappUrl()}
  target="_blank"
  rel="noopener"
  class="fixed right-4 bottom-4 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-whatsapp-oscuro shadow-lg transition-transform hover:scale-110"
  aria-label="Escribir por WhatsApp (abre en una pestaña nueva)"
>
  <Icon name="simple-icons:whatsapp" class="h-8 w-8 text-white" aria-hidden="true" />
</a>
