---
import BaseLayout from '../layouts/BaseLayout.astro';
import Seccion from '../components/Seccion.astro';
import VideoYouTube from '../components/VideoYouTube.astro';

// How-to videos published by CBM. Adding one = add an object.
const videos = [
  {
    id: 'qJAQaLPnsMo',
    titulo: 'Instructivo Contadora de Monedas | CBM LTDA | CS2000 – TC220H',
  },
  {
    id: 'AqG4AzkgyFA',
    titulo: 'Instructivo Recontadora de Fajos | CBM LTDA | TW880 – TW600L',
  },
];
---

<BaseLayout
  titulo="Material de apoyo"
  descripcion="Videos instructivos de CBM Ltda para contadoras de monedas y recontadoras de fajos, y la capacitación completa de la contadora de billetes TBM EP100."
>
  <Seccion
    nivel="h1"
    antetitulo="Soporte"
    titulo="Material de apoyo"
    subtitulo="Instructivos en video para sacar el máximo provecho de sus equipos."
  >
    <div class="grid gap-10 md:grid-cols-2">
      {
        videos.map((v) => (
          <div>
            <h2 class="mb-3 text-lg font-semibold text-gray-900">{v.titulo}</h2>
            <VideoYouTube id={v.id} titulo={v.titulo} />
          </div>
        ))
      }
    </div>
  </Seccion>

  <Seccion
    tono="gris"
    antetitulo="Contadora de billetes"
    titulo="Capacitación TBM EP100"
    subtitulo="El manual de usuario y siete videos paso a paso para operar la contadora de billetes TBM EP100, en su propia página."
  >
    <a
      href="/capacitacion-tbm/"
      class="inline-flex items-center rounded-lg border border-marca-300 px-5 py-3 font-semibold text-marca-700 transition-colors hover:bg-white"
    >
      Ver la capacitación TBM EP100
    </a>
  </Seccion>
</BaseLayout>
