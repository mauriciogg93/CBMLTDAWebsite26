// Deploy to Cloudflare Workers (static assets, no adapter). This is the WHOLE deploy
// config: Cloudflare Workers Builds reads it from the repo on every push to main (see PLAN.md).
// Manual (first deploy or debugging): npx wrangler login (once) → npm run deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cbmltdawebsite26",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // workers.dev stays on next to the custom domain (verification URL; canonical tags point
  // at the domain) and every branch build gets a Preview URL. Without these two keys a
  // `routes` block silently switches workers.dev off on deploy.
  "workers_dev": true,
  "preview_urls": true,
  // Worker Previews: once Settings → Builds is switched to Previews (one-time, irreversible), each
  // branch builds its own Preview, <branch>-cbmltdawebsite26.<account>.workers.dev, with
  // `npx wrangler preview` (wrangler 4.135 or later), which fails without this block. Empty: the
  // Preview needs no settings of its own. `wrangler deploy` ignores it.
  "previews": {},
  // Custom domain: declarative, nothing in the dashboard. The cbmltda.com.co zone lives in
  // Cloudflare (`dig NS cbmltda.com.co` shows *.ns.cloudflare.com); on each deploy Cloudflare
  // keeps the DNS records and the certificate for both hostnames. Hostnames only: no scheme,
  // no path. To roll back to another origin: comment this block out, push, and recreate the
  // A record in the zone's DNS panel.
  "routes": [
    { "pattern": "cbmltda.com.co", "custom_domain": true },
    { "pattern": "www.cbmltda.com.co", "custom_domain": true }
  ]
}
