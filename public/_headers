# Headers for Cloudflare Workers (static assets): immutable cache for hashed files, a short
# cache for the rest and the six security headers `npm run verify` expects.
# HSTS is set by the zone (Always Use HTTPS), not here.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/favicon.svg
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/og.jpg
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=3600
/manuales/*
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
